# Spring 백엔드 실행에 필요한 환경변수 (값은 각자 만들어서 사용, 이 파일 복사본에 실제 값 넣지 말 것)
# 만드는 방법: docs/setup.md 3장

# MySQL (crop_backend 계정 — my_ncpms 에 SELECT/INSERT/UPDATE/DELETE 권한만)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=my_ncpms
DB_USER=crop_backend
DB_PASSWORD=

# AI 서버 호출용 공유 토큰 (AI 서버의 INTERNAL_TOKEN 과 같은 값)
AI_BASE_URL=http://127.0.0.1:8000
INTERNAL_TOKEN=

# JWT 서명 키 (32자 이상 무작위 문자열)
JWT_SECRET=

# 사진 저장 폴더 (기본: ~/crop-data/uploads)
UPLOAD_DIR=

# React 개발 서버 주소 (CORS)
CORS_ORIGINS=http://localhost:5173
